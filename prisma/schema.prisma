// SKP DPUPK — Lean Schema (hanya yang dibutuhkan, 2026-08-24)
// Cascading: supervisor_id (org tree) vs parent_id (plan tree)
// Progress dihitung: jumlah entri (langsung + turunan) / target — bisa >100% (cap 150%)

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ── Organisasi (role = jabatan tunggal) ───────────────
model Employee {
  id             String  @id @default(cuid())
  userId         String  @unique @map("user_id")
  employeeNumber String  @unique @map("employee_number")
  name           String
  email          String  @unique
  password       String  @default("$2b$10$49djtnPFASpNsPac7EGsNuFQIXbZy.ypISMj13WQ/o1SIUCYjXID2") // password
  supervisorId   String? @map("supervisor_id")
  role           String  // admin | direktur | supervisor | staff — dipakai sebagai jabatan tunggal
  avatar         String  @default("")
  isActive       Boolean @default(true) @map("is_active")
  lastLoginAt    String? @map("last_login_at")
  createdAt      String  @default("2026-01-01") @map("created_at")

  supervisor Employee?  @relation("Supervisor", fields: [supervisorId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  subordinates Employee[] @relation("Supervisor")

  createdPlans   PerformancePlan[] @relation("CreatedBy")
  assignedPlans  PerformancePlan[] @relation("AssignedTo")
  attachments    Attachment[]
  realizations   Realization[]     @relation("RealizationUploader")
  logs           ActivityLog[]

  @@index([supervisorId])
  @@index([role])
  @@map("employees")
}

// ── Periode SKP ──────────────────────────────────────────────
model SkpPeriod {
  id        String @id @default(cuid())
  name      String
  year      Int
  startDate String @map("start_date")
  endDate   String @map("end_date")
  plans     PerformancePlan[]

  @@map("skp_periods")
}

// ── Rencana Kinerja (inti: cascading via parentId) ───────────
model PerformancePlan {
  id          String  @id @default(cuid())
  parentId    String? @map("parent_id")
  skpPeriodId String  @map("skp_period_id")
  createdBy   String  @map("created_by")
  assignedTo  String  @map("assigned_to")
  title       String
  description String  @default("") // legacy, tidak dipakai UI baru
  target      String  // jumlah target (kuantitatif, mis. "6")
  progress    Int     @default(0) // 0..150, dihitung jumlah entri / target
  createdAt   String  @default("2026-01-01") @map("created_at")
  plannedDate String? @map("planned_date") // tanggal rencana akan dijalankan (YYYY-MM-DD)
  plannedTime String? @map("planned_time") // jam rencana akan dijalankan (HH:mm 24H)

  parent   PerformancePlan?  @relation("PlanParent", fields: [parentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  children PerformancePlan[] @relation("PlanParent")
  period   SkpPeriod         @relation(fields: [skpPeriodId], references: [id])
  creator  Employee          @relation("CreatedBy", fields: [createdBy], references: [id])
  assignee Employee          @relation("AssignedTo", fields: [assignedTo], references: [id])
  realizations Realization[]
  attachments  Attachment[]
  customTargets PlanTarget[]

  @@index([parentId])
  @@index([assignedTo])
  @@index([skpPeriodId])
  @@map("performance_plans")
}

// ── Target Kustom (hanya direktur bisa buat) ─────────────────
model PlanTarget {
  id        String @id @default(cuid())
  planId    String @map("plan_id")
  name      String // e.g., "jumlah peserta", "honor"
  value     String // e.g., "250", "500000"
  unit      String // e.g., "orang", "perjam"
  createdAt String @default("2026-01-01") @map("created_at")

  plan PerformancePlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@map("plan_targets")
}

// ── Realisasi (tiap entri = 1 progress, punya judul) ─────────
model Realization {
  id                  String  @id @default(cuid())
  performancePlanId   String  @map("performance_plan_id")
  title               String  @default("Realisasi") @map("title")
  realizationValue    String  @default("1") @map("realization_value") // selalu "1" (1 entri = 1)
  realizationDescription String @default("") @map("realization_description")
  realizationDate     String  @map("realization_date")
  realizationTime     String  @default("09:00") @map("realization_time") // jam 24H HH:mm
  uploadedBy          String? @map("uploaded_by") // penulis realisasi — hak edit/hapus
  createdAt           String  @default("2026-01-01") @map("created_at")

  plan        PerformancePlan @relation(fields: [performancePlanId], references: [id], onDelete: Cascade)
  uploader    Employee?       @relation("RealizationUploader", fields: [uploadedBy], references: [id], onDelete: SetNull)
  attachments Attachment[]

  @@index([uploadedBy])
  @@index([performancePlanId])
  @@map("performance_realizations")
}

// ── Bukti (file upload) ──────────────────────────────────────
model Attachment {
  id                String  @id @default(cuid())
  performancePlanId String  @map("performance_plan_id")
  realizationId     String? @map("realization_id")
  fileName          String  @map("file_name")
  filePath          String  @map("file_path")
  fileSize          String  @map("file_size")
  uploadedBy        String  @map("uploaded_by")
  date              String
  createdAt         String  @default("2026-01-01") @map("created_at")

  plan        PerformancePlan @relation(fields: [performancePlanId], references: [id], onDelete: Cascade)
  realization Realization?    @relation(fields: [realizationId], references: [id], onDelete: SetNull)
  uploader    Employee        @relation(fields: [uploadedBy], references: [id])

  @@index([performancePlanId])
  @@index([realizationId])
  @@map("performance_attachments")
}

// ── Audit Trail ──────────────────────────────────────────────
model ActivityLog {
  id          String @id @default(cuid())
  userId      String @map("user_id")
  userName    String @map("user_name")
  action      String
  description String
  entityType  String @map("entity_type")
  entityId    String @map("entity_id")
  createdAt   String @map("created_at")

  user Employee @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@map("activity_logs")
}
